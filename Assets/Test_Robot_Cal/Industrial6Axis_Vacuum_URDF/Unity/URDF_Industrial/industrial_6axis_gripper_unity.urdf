<?xml version="1.0"?>
<!-- 6-axis industrial robot (realvirtual Robot.fbx) -> URDF. Zero pose = FBX pose (upper arm vertical, forearm horizontal). -->
<robot name="industrial_6axis_gripper">
  <link name="base_link">
    <inertial><origin xyz="-0.0588 0.0000 0.0995" rpy="0 0 0"/><mass value="60"/>
      <inertia ixx="1.52155" ixy="0" ixz="0" iyy="2.19012" iyz="0" izz="3.31604"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/base_link.obj"/></geometry><material name="base_link_mat"><color rgba="0.20 0.20 0.22 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/base_link.obj"/></geometry></collision>
  </link>
  <link name="link_1">
    <inertial><origin xyz="0.0437 0.0489 0.4013" rpy="0 0 0"/><mass value="55"/>
      <inertia ixx="2.56251" ixy="0" ixz="0" iyy="2.76383" iyz="0" izz="2.88628"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_1.obj"/></geometry><material name="link_1_mat"><color rgba="0.96 0.74 0.05 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_1.obj"/></geometry></collision>
  </link>
  <link name="link_2">
    <inertial><origin xyz="0.0000 -0.1701 0.4023" rpy="0 0 0"/><mass value="30"/>
      <inertia ixx="2.97115" ixy="0" ixz="0" iyy="3.01072" iyz="0" izz="0.30225"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_2.obj"/></geometry><material name="link_2_mat"><color rgba="0.96 0.74 0.05 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_2.obj"/></geometry></collision>
  </link>
  <link name="link_3">
    <inertial><origin xyz="0.0801 0.0501 0.0883" rpy="0 0 0"/><mass value="28"/>
      <inertia ixx="0.82885" ixy="0" ixz="0" iyy="1.03744" iyz="0" izz="0.95007"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_3.obj"/></geometry><material name="link_3_mat"><color rgba="0.96 0.74 0.05 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_3.obj"/></geometry></collision>
  </link>
  <link name="link_4">
    <inertial><origin xyz="-0.2457 0.0030 -0.0001" rpy="0 0 0"/><mass value="12"/>
      <inertia ixx="0.08542" ixy="0" ixz="0" iyy="0.49906" iyz="0" izz="0.51761"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_4.obj"/></geometry><material name="link_4_mat"><color rgba="0.96 0.74 0.05 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_4.obj"/></geometry></collision>
  </link>
  <link name="link_5">
    <inertial><origin xyz="0.0000 -0.0015 -0.0000" rpy="0 0 0"/><mass value="4"/>
      <inertia ixx="0.01312" ixy="0" ixz="0" iyy="0.01478" iyz="0" izz="0.01310"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_5.obj"/></geometry><material name="link_5_mat"><color rgba="0.96 0.74 0.05 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_5.obj"/></geometry></collision>
  </link>
  <link name="link_6">
    <inertial><origin xyz="-0.0327 -0.0000 -0.0000" rpy="0 0 0"/><mass value="1"/>
      <inertia ixx="0.00243" ixy="0" ixz="0" iyy="0.00149" iyz="0" izz="0.00166"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_6.obj"/></geometry><material name="link_6_mat"><color rgba="0.55 0.55 0.58 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/link_6.obj"/></geometry></collision>
  </link>
  <joint name="joint_1" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.9671" upper="2.9671" effort="1500" velocity="2.9"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <origin xyz="0.16342 0 0.46224" rpy="0 0 0"/>
    <parent link="link_1"/><child link="link_2"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="2.6180" effort="1500" velocity="2.9"/>
  </joint>
  <joint name="joint_3" type="revolute">
    <origin xyz="0 0 0.84044" rpy="0 0 0"/>
    <parent link="link_2"/><child link="link_3"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.7925" upper="3.1416" effort="800" velocity="3.1"/>
  </joint>
  <joint name="joint_4" type="revolute">
    <origin xyz="0.89647 0 0.16342" rpy="0 0 0"/>
    <parent link="link_3"/><child link="link_4"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-3.4907" upper="3.4907" effort="300" velocity="6.2"/>
  </joint>
  <joint name="joint_5" type="revolute">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="link_4"/><child link="link_5"/>
    <axis xyz="0 -1 0"/>
    <limit lower="-2.4435" upper="2.4435" effort="300" velocity="6.2"/>
  </joint>
  <joint name="joint_6" type="revolute">
    <origin xyz="0.12607 0 0" rpy="0 0 0"/>
    <parent link="link_5"/><child link="link_6"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-6.2832" upper="6.2832" effort="150" velocity="9.5"/>
  </joint>
  <!-- tool0: flange face (x = tool approach direction) -->
  <link name="tool0"/>
  <joint name="link_6-tool0" type="fixed"><origin xyz="0 0 0" rpy="0 0 0"/><parent link="link_6"/><child link="tool0"/></joint>

  <!-- ===== Parallel gripper (realvirtual GripperRobot.fbx) on tool0 =====
       gripper x = approach, y = finger motion. finger joint q = center~inner face [m], gap = 2q
       max gap 0.315 m (finger carriage stays inside housing), as modelled 0.305 m -->
  <joint name="tool0-gripper" type="fixed"><origin xyz="0 0 0" rpy="0 0 0"/><parent link="tool0"/><child link="gripper_base_link"/></joint>
  <link name="gripper_base_link">
    <inertial><origin xyz="0.0462 -0.0001 0.0000" rpy="0 0 0"/><mass value="3.0"/>
      <inertia ixx="0.03903" ixy="0" ixz="0" iyy="0.00545" iyz="0" izz="0.03784"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/gripper_base_link.obj"/></geometry><material name="gripper_base_link_mat"><color rgba="0.12 0.12 0.13 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/gripper_base_link.obj"/></geometry></collision>
  </link>
  <joint name="gripper_left_finger_joint" type="prismatic">
    <origin xyz="0 -0.00150 0" rpy="0 0 0"/><parent link="gripper_base_link"/><child link="gripper_left_finger_link"/>
    <axis xyz="0 1 0"/><limit lower="0.0" upper="0.1574" effort="200" velocity="0.2"/>
  </joint>
  <link name="gripper_left_finger_link">
    <inertial><origin xyz="0.1977 0.0151 -0.0007" rpy="0 0 0"/><mass value="0.5"/>
      <inertia ixx="0.00028" ixy="0" ixz="0" iyy="0.00379" iyz="0" izz="0.00358"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/gripper_left_finger_link.obj"/></geometry><material name="gripper_left_finger_link_mat"><color rgba="0.15 0.35 0.80 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/gripper_left_finger_link.obj"/></geometry></collision>
  </link>
  <joint name="gripper_right_finger_joint" type="prismatic">
    <origin xyz="0 -0.00150 0" rpy="0 0 0"/><parent link="gripper_base_link"/><child link="gripper_right_finger_link"/>
    <axis xyz="0 -1 0"/><limit lower="0.0" upper="0.1574" effort="200" velocity="0.2"/>
    <mimic joint="gripper_left_finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="gripper_right_finger_link">
    <inertial><origin xyz="0.1977 -0.0151 0.0004" rpy="0 0 0"/><mass value="0.5"/>
      <inertia ixx="0.00028" ixy="0" ixz="0" iyy="0.00379" iyz="0" izz="0.00358"/></inertial>
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/gripper_right_finger_link.obj"/></geometry><material name="gripper_right_finger_link_mat"><color rgba="0.15 0.35 0.80 1"/></material></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="package://industrial_6axis_description/meshes/gripper_right_finger_link.obj"/></geometry></collision>
  </link>
  <!-- TCP: 손끝 3cm 위, 두 손가락 사이 중심 (tool0 기준 0.3135 m) -->
  <joint name="gripper-tcp" type="fixed"><origin xyz="0.31349 -0.00150 0" rpy="0 0 0"/><parent link="gripper_base_link"/><child link="tcp"/></joint>
  <link name="tcp"/>
</robot>
